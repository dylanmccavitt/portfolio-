---
/**
 * Explore project-page body layouts. Presentation only — catalog `about`
 * stays [problem, approach, outcome]. Used by the live project route and the
 * /explore/project-layouts comparison lab.
 */
import type { ProjectDetailReadModel } from '@/lib/projects/read-models';

export type ProjectPageLayout =
  | 'story-rail'
  | 'numbered-beats'
  | 'outcome-first'
  | 'two-column'
  | 'index-strip'
  | 'triptych'
  | 'tight-dossier'
  | 'hero-proof';

interface Props {
  project: ProjectDetailReadModel;
  layout?: ProjectPageLayout;
}

const { project: p, layout = 'story-rail' } = Astro.props;

const imageShots = p.shots.filter((shot) => shot.kind === 'image');
const hasStory = p.about.length >= 3;
const problem = hasStory ? p.about[0] : p.about[0] ?? '';
const approach = hasStory ? p.about[1] : p.about[1] ?? '';
const outcome = hasStory ? p.about[2] : p.about[2] ?? '';

const beats = hasStory
  ? [
      { id: 'problem', n: '01', label: 'Problem', copy: problem },
      { id: 'approach', n: '02', label: 'Approach', copy: approach },
      { id: 'outcome', n: '03', label: 'Outcome', copy: outcome },
    ]
  : [{ id: 'about', n: '01', label: 'About', copy: p.about.join(' ') }];
---

<div class={`look-paper look-layout look-layout--${layout}`}>
  {layout === 'two-column' ? (
    <div class="look-split">
      <aside class="look-split-aside">
        <div class="frost-doc-title look-title">
          <p class="frost-kicker">{p.area} · {p.status[1]} · {p.year}</p>
          <h1>{p.title}</h1>
          <p class="look-title-line">{p.line}</p>
        </div>
        {p.stack.length > 0 && (
          <div class="frost-doc-facts">
            {p.stack.map((entry) => <span>{entry.label}: {entry.value}</span>)}
          </div>
        )}
        <div class="frost-doc-facts">
          {p.metrics.map((metric) => <span>{metric.value} · {metric.label}</span>)}
        </div>
      </aside>
      <div class="look-split-main">
        {beats.map((beat) => (
          <section class="look-beat" aria-labelledby={`project-${beat.id}`}>
            <h2 id={`project-${beat.id}`}>{beat.label}</h2>
            <p class="look-copy">{beat.copy}</p>
          </section>
        ))}
      </div>
    </div>
  ) : layout === 'index-strip' ? (
    <div class="look-index">
      <nav class="look-index-nav" aria-label="On this page">
        {beats.map((beat) => (
          <a href={`#project-${beat.id}`}>{beat.label}</a>
        ))}
        {p.stack.length > 0 && <a href="#project-stack">Stack</a>}
        <a href="#project-metrics">Metrics</a>
        {imageShots.length > 0 && <a href="#project-screens">Screens</a>}
      </nav>
      <div class="look-index-main">
        <div class="frost-doc-title look-title">
          <p class="frost-kicker">{p.area} · {p.status[1]} · {p.year}</p>
          <h1>{p.title}</h1>
          <p class="look-title-line">{p.line}</p>
        </div>
        {beats.map((beat) => (
          <section class="look-beat" aria-labelledby={`project-${beat.id}`}>
            <h2 id={`project-${beat.id}`}>{beat.label}</h2>
            <p class="look-copy">{beat.copy}</p>
          </section>
        ))}
        {p.stack.length > 0 && (
          <section class="look-beat" aria-labelledby="project-stack">
            <h2 id="project-stack">Stack</h2>
            <div class="frost-doc-facts">
              {p.stack.map((entry) => <span>{entry.label}: {entry.value}</span>)}
            </div>
          </section>
        )}
        <section class="look-beat" aria-labelledby="project-metrics">
          <h2 id="project-metrics">Metrics</h2>
          <div class="frost-doc-facts">
            {p.metrics.map((metric) => <span>{metric.value} · {metric.label}</span>)}
          </div>
        </section>
        {imageShots.length > 0 && (
          <section class="look-beat" aria-labelledby="project-screens">
            <h2 id="project-screens">Screens</h2>
            <div class="frost-gallery">
              {imageShots.map((shot) => (
                <figure>
                  <img src={shot.src} alt={shot.caption} loading="lazy" />
                  <figcaption>{shot.caption}</figcaption>
                </figure>
              ))}
            </div>
          </section>
        )}
      </div>
    </div>
  ) : (
    <>
      <div class="frost-doc-title look-title">
        <p class="frost-kicker">{p.area} · {p.status[1]} · {p.year}</p>
        <h1>{p.title}</h1>
        <p class="look-title-line">{p.line}</p>
      </div>

      {layout === 'hero-proof' && (
        <div class="look-proof-strip" aria-label="Metrics">
          {p.metrics.map((metric) => (
            <div class="look-proof-cell">
              <strong>{metric.value}</strong>
              <span>{metric.label}</span>
            </div>
          ))}
        </div>
      )}

      {layout === 'outcome-first' && hasStory && (
        <>
          <section class="look-outcome-hero" aria-labelledby="project-outcome">
            <p class="frost-kicker">Outcome</p>
            <h2 id="project-outcome" class="frost-sr-only">Outcome</h2>
            <p class="look-outcome-copy">{outcome}</p>
          </section>
          <div class="look-outcome-pair">
            <section aria-labelledby="project-problem">
              <h2 id="project-problem">Problem</h2>
              <p class="look-copy">{problem}</p>
            </section>
            <section aria-labelledby="project-approach">
              <h2 id="project-approach">Approach</h2>
              <p class="look-copy">{approach}</p>
            </section>
          </div>
        </>
      )}

      {layout === 'triptych' && hasStory && (
        <div class="look-triptych">
          {beats.map((beat) => (
            <section aria-labelledby={`project-${beat.id}`}>
              <h2 id={`project-${beat.id}`}>{beat.label}</h2>
              <p class="look-copy">{beat.copy}</p>
            </section>
          ))}
        </div>
      )}

      {layout === 'numbered-beats' && (
        <div class="look-numbered">
          {beats.map((beat) => (
            <section class="look-numbered-row" aria-labelledby={`project-${beat.id}`}>
              <span class="look-numbered-n" aria-hidden="true">{beat.n}</span>
              <div>
                <h2 id={`project-${beat.id}`}>{beat.label}</h2>
                <p class="look-copy">{beat.copy}</p>
              </div>
            </section>
          ))}
        </div>
      )}

      {layout === 'tight-dossier' && (
        <ol class="look-dossier">
          {beats.map((beat) => (
            <li>
              <span class="look-dossier-n">{beat.n}</span>
              <strong>{beat.label}</strong>
              <span>{beat.copy}</span>
            </li>
          ))}
        </ol>
      )}

      {layout === 'story-rail' && (
        <>
          {beats.map((beat) => (
            <section class="look-rail" aria-labelledby={`project-${beat.id}`}>
              <h2 id={`project-${beat.id}`}>{beat.label}</h2>
              <p class="look-copy">{beat.copy}</p>
            </section>
          ))}
        </>
      )}

      {/* Stack / metrics / screens — shared foot. Index-strip and two-column
          already returned above with their own meta placement. */}
      {p.stack.length > 0 && (
        <section
          class={layout === 'story-rail' ? 'look-rail' : 'look-block'}
          aria-labelledby="project-stack"
        >
          <h2 id="project-stack">Stack</h2>
          <div class="frost-doc-facts">
            {p.stack.map((entry) => <span>{entry.label}: {entry.value}</span>)}
          </div>
        </section>
      )}
      {layout !== 'hero-proof' && (
        <section
          class={layout === 'story-rail' ? 'look-rail' : 'look-block'}
          aria-labelledby="project-metrics"
        >
          <h2 id="project-metrics">Metrics</h2>
          <div class="frost-doc-facts">
            {p.metrics.map((metric) => <span>{metric.value} · {metric.label}</span>)}
          </div>
        </section>
      )}
      {imageShots.length > 0 && (
        <section
          class={layout === 'story-rail' ? 'look-rail' : 'look-block'}
          aria-labelledby="project-screens"
        >
          <h2 id="project-screens">Screens</h2>
          <div class="frost-gallery">
            {imageShots.map((shot) => (
              <figure>
                <img src={shot.src} alt={shot.caption} loading="lazy" />
                <figcaption>{shot.caption}</figcaption>
              </figure>
            ))}
          </div>
        </section>
      )}
    </>
  )}

  <nav class="frost-doc-actions" aria-label="Project actions">
    {p.links.map((link, index) => (
      <a class:list={[{ 'is-fill': index === 0 }]} href={link.href} target="_blank" rel="noopener">{link.label}</a>
    ))}
    <a class="is-quiet" href="/#work">← All work</a>
  </nav>
</div>
