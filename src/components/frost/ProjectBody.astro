---
/**
 * Project detail body — index-strip layout. Catalog `about` stays
 * [problem, approach, outcome]; this is presentation only.
 */
import type { ProjectDetailReadModel } from '@/lib/projects/read-models';

interface Props {
  project: ProjectDetailReadModel;
}

const { project: p } = Astro.props;

const imageShots = p.shots.filter((shot) => shot.kind === 'image');
const hasStory = p.about.length >= 3;
const problem = hasStory ? p.about[0] : p.about[0] ?? '';
const approach = hasStory ? p.about[1] : p.about[1] ?? '';
const outcome = hasStory ? p.about[2] : p.about[2] ?? '';

const beats = hasStory
  ? [
      { id: 'problem', n: '01', label: 'Problem', copy: problem },
      { id: 'approach', n: '02', label: 'Approach', copy: approach },
      { id: 'outcome', n: '03', label: 'Outcome', copy: outcome },
    ]
  : [{ id: 'about', n: '01', label: 'About', copy: p.about.join(' ') }];
---

<div class="look-paper look-layout look-layout--index-strip">
  <div class="look-index">
    <nav class="look-index-nav" aria-label="On this page">
      {beats.map((beat) => (
        <a href={`#project-${beat.id}`}>{beat.label}</a>
      ))}
      {p.stack.length > 0 && <a href="#project-stack">Stack</a>}
      <a href="#project-metrics">Metrics</a>
      {imageShots.length > 0 && <a href="#project-screens">Screens</a>}
    </nav>
    <div class="look-index-main">
      <div class="frost-doc-title look-title look-index-title">
        <p class="frost-kicker">{p.area} · {p.status[1]} · {p.year}</p>
        <h1>{p.title}</h1>
        <p class="look-title-line">{p.line}</p>
      </div>
      {/* Wide screens split this into prose (left) and a sticky Stack /
          Metrics rail (right); below the breakpoint it flows in the same
          order it always has. See `.look-index-grid` in frost.css. */}
      <div class="look-index-grid">
        <div class="look-index-copy-col">
          {beats.map((beat) => (
            <section class="look-index-section" id={`project-${beat.id}`} aria-labelledby={`heading-${beat.id}`}>
              <h2 id={`heading-${beat.id}`}>{beat.label}</h2>
              <p class="look-copy">{beat.copy}</p>
            </section>
          ))}
        </div>
        <aside class="look-index-side">
          {p.stack.length > 0 && (
            <section class="look-index-section" id="project-stack" aria-labelledby="heading-stack">
              <h2 id="heading-stack">Stack</h2>
              <dl class="frost-detail-rail frost-detail-rail--stack">
                {p.stack.map((entry) => (
                  <div class="frost-detail-rail-row">
                    <dt>{entry.label}:</dt>
                    <dd>{entry.value}</dd>
                  </div>
                ))}
              </dl>
            </section>
          )}
          <section class="look-index-section" id="project-metrics" aria-labelledby="heading-metrics">
            <h2 id="heading-metrics">Metrics</h2>
            <dl class="frost-detail-rail frost-detail-rail--metrics">
              {p.metrics.map((metric) => (
                <div class="frost-detail-rail-row">
                  <dt>{metric.label}</dt>
                  <dd>{metric.value}</dd>
                </div>
              ))}
            </dl>
          </section>
        </aside>
      </div>
      {imageShots.length > 0 && (
        <section class="look-index-section look-index-section--screens" id="project-screens" aria-labelledby="heading-screens">
          <h2 id="heading-screens">Screens</h2>
          <div class="frost-gallery frost-gallery--strip">
            {imageShots.map((shot) => (
              <figure>
                <a href={shot.src} data-frost-gallery-image data-frost-gallery-caption={shot.caption} aria-label={`Open ${shot.caption} full size`}>
                  <img src={shot.src} alt={shot.caption} loading="lazy" />
                </a>
                <figcaption>{shot.caption}</figcaption>
              </figure>
            ))}
          </div>
        </section>
      )}
    </div>
  </div>

  <nav class="frost-doc-actions" aria-label="Project actions">
    {p.links.map((link) => (
      <a href={link.href} target="_blank" rel="noopener">{link.label.replace(/\s*↗$/, '')}</a>
    ))}
    <a class="is-quiet" href="/#work">← All work</a>
  </nav>
</div>

<dialog class="frost-image-lightbox" aria-label="Screenshot preview">
  <div class="frost-image-lightbox-bar">
    <p class="frost-image-lightbox-caption"></p>
    <button class="frost-image-lightbox-close" type="button">Close</button>
  </div>
  <img class="frost-image-lightbox-image" alt="" />
  {imageShots.length > 1 && (
    <div class="frost-image-lightbox-nav">
      <button class="frost-image-lightbox-prev" type="button" aria-label="Previous screen">←</button>
      <p class="frost-image-lightbox-count"></p>
      <button class="frost-image-lightbox-next" type="button" aria-label="Next screen">→</button>
    </div>
  )}
</dialog>

<script>
  const gallery = document.querySelector('.frost-gallery');
  const lightbox = document.querySelector('.frost-image-lightbox');

  if (gallery instanceof HTMLElement && lightbox instanceof HTMLDialogElement) {
    const image = lightbox.querySelector<HTMLImageElement>('.frost-image-lightbox-image');
    const caption = lightbox.querySelector<HTMLElement>('.frost-image-lightbox-caption');
    const close = lightbox.querySelector<HTMLButtonElement>('.frost-image-lightbox-close');
    const prev = lightbox.querySelector<HTMLButtonElement>('.frost-image-lightbox-prev');
    const next = lightbox.querySelector<HTMLButtonElement>('.frost-image-lightbox-next');
    const count = lightbox.querySelector<HTMLElement>('.frost-image-lightbox-count');
    const links = Array.from(gallery.querySelectorAll<HTMLAnchorElement>('a[data-frost-gallery-image]'));
    const pad = (n: number) => String(n).padStart(2, '0');
    let current = 0;

    const show = (index: number) => {
      const link = links[index];
      if (!link || !image || !caption) return;
      current = index;
      image.src = link.href;
      image.alt = link.dataset.frostGalleryCaption ?? '';
      caption.textContent = link.dataset.frostGalleryCaption ?? '';
      if (count) count.textContent = `${pad(index + 1)} / ${pad(links.length)}`;
      if (prev) prev.disabled = index === 0;
      if (next) next.disabled = index === links.length - 1;
    };

    gallery.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const link = target.closest('a[data-frost-gallery-image]');
      if (!(link instanceof HTMLAnchorElement)) return;

      event.preventDefault();
      show(links.indexOf(link));
      lightbox.showModal();
    });

    prev?.addEventListener('click', () => show(current - 1));
    next?.addEventListener('click', () => show(current + 1));
    lightbox.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight' && current < links.length - 1) show(current + 1);
      else if (event.key === 'ArrowLeft' && current > 0) show(current - 1);
    });

    close?.addEventListener('click', () => lightbox.close());
    lightbox.addEventListener('click', (event) => {
      if (event.target === lightbox) lightbox.close();
    });
  }

  // Filmstrip edge state: the fades only make sense while there is more
  // strip in that direction, so the ends drop their side of the mask.
  const strip = document.querySelector('.frost-gallery--strip');
  if (strip instanceof HTMLElement) {
    const sync = () => {
      const max = strip.scrollWidth - strip.clientWidth;
      strip.classList.toggle('is-at-start', strip.scrollLeft <= 2);
      strip.classList.toggle('is-at-end', strip.scrollLeft >= max - 2);
    };

    // Shrink-wrap each figure to its still's rendered width. Flex sizes the
    // figures from the images' NATURAL widths, which overshoots once the
    // height cap scales a still down; measuring after load (and again on
    // resize, when the cap changes) closes that gap. Without JS the figures
    // just stay wide — the strip still works.
    const fit = () => {
      for (const figure of strip.querySelectorAll('figure')) {
        const img = figure.querySelector('img');
        if (img instanceof HTMLImageElement && img.complete && img.naturalWidth > 0 && img.clientWidth > 0) {
          figure.style.flexBasis = `${img.clientWidth}px`;
        }
      }
      sync();
    };
    for (const img of strip.querySelectorAll('img')) {
      if (img instanceof HTMLImageElement && !img.complete) {
        img.addEventListener('load', fit, { once: true });
      }
    }
    strip.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', fit);
    fit();
  }
</script>
