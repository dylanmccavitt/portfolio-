---
/**
 * Project detail body — index-strip layout. Catalog `about` stays
 * [problem, approach, outcome]; this is presentation only.
 */
import type { ProjectDetailReadModel } from '@/lib/projects/read-models';

interface Props {
  project: ProjectDetailReadModel;
}

const { project: p } = Astro.props;

const imageShots = p.shots.filter((shot) => shot.kind === 'image');
const hasStory = p.about.length >= 3;
const problem = hasStory ? p.about[0] : p.about[0] ?? '';
const approach = hasStory ? p.about[1] : p.about[1] ?? '';
const outcome = hasStory ? p.about[2] : p.about[2] ?? '';

const beats = hasStory
  ? [
      { id: 'problem', n: '01', label: 'Problem', copy: problem },
      { id: 'approach', n: '02', label: 'Approach', copy: approach },
      { id: 'outcome', n: '03', label: 'Outcome', copy: outcome },
    ]
  : [{ id: 'about', n: '01', label: 'About', copy: p.about.join(' ') }];
---

<div class="look-paper look-layout look-layout--index-strip">
  <div class="look-index">
    <nav class="look-index-nav" aria-label="On this page">
      {beats.map((beat) => (
        <a href={`#project-${beat.id}`}>{beat.label}</a>
      ))}
      {p.stack.length > 0 && <a href="#project-stack">Stack</a>}
      <a href="#project-metrics">Metrics</a>
      {imageShots.length > 0 && <a href="#project-screens">Screens</a>}
    </nav>
    <div class="look-index-main">
      <div class="frost-doc-title look-title look-index-title">
        <p class="frost-kicker">{p.area} · {p.status[1]} · {p.year}</p>
        <h1>{p.title}</h1>
        <p class="look-title-line">{p.line}</p>
      </div>
      {beats.map((beat) => (
        <section class="look-index-section" id={`project-${beat.id}`} aria-labelledby={`heading-${beat.id}`}>
          <h2 id={`heading-${beat.id}`}>{beat.label}</h2>
          <p class="look-copy">{beat.copy}</p>
        </section>
      ))}
      {p.stack.length > 0 && (
        <section class="look-index-section" id="project-stack" aria-labelledby="heading-stack">
          <h2 id="heading-stack">Stack</h2>
          <dl class="frost-detail-rail frost-detail-rail--stack">
            {p.stack.map((entry) => (
              <div class="frost-detail-rail-row">
                <dt>{entry.label}:</dt>
                <dd>{entry.value}</dd>
              </div>
            ))}
          </dl>
        </section>
      )}
      <section class="look-index-section" id="project-metrics" aria-labelledby="heading-metrics">
        <h2 id="heading-metrics">Metrics</h2>
        <dl class="frost-detail-rail frost-detail-rail--metrics">
          {p.metrics.map((metric) => (
            <div class="frost-detail-rail-row">
              <dt>{metric.label}</dt>
              <dd>{metric.value}</dd>
            </div>
          ))}
        </dl>
      </section>
      {imageShots.length > 0 && (
        <section class="look-index-section" id="project-screens" aria-labelledby="heading-screens">
          <h2 id="heading-screens">Screens</h2>
          <div class="frost-gallery">
            {imageShots.map((shot) => (
              <figure>
                <a href={shot.src} data-frost-gallery-image data-frost-gallery-caption={shot.caption} aria-label={`Open ${shot.caption} full size`}>
                  <img src={shot.src} alt={shot.caption} loading="lazy" />
                </a>
                <figcaption>{shot.caption}</figcaption>
              </figure>
            ))}
          </div>
        </section>
      )}
    </div>
  </div>

  <nav class="frost-doc-actions" aria-label="Project actions">
    {p.links.map((link) => (
      <a href={link.href} target="_blank" rel="noopener">{link.label.replace(/\s*↗$/, '')}</a>
    ))}
    <a class="is-quiet" href="/#work">← All work</a>
  </nav>
</div>

<dialog class="frost-image-lightbox" aria-label="Screenshot preview">
  <div class="frost-image-lightbox-bar">
    <p class="frost-image-lightbox-caption"></p>
    <button class="frost-image-lightbox-close" type="button">Close</button>
  </div>
  <img class="frost-image-lightbox-image" alt="" />
</dialog>

<script>
  const gallery = document.querySelector('.frost-gallery');
  const lightbox = document.querySelector('.frost-image-lightbox');

  if (gallery instanceof HTMLElement && lightbox instanceof HTMLDialogElement) {
    const image = lightbox.querySelector<HTMLImageElement>('.frost-image-lightbox-image');
    const caption = lightbox.querySelector<HTMLElement>('.frost-image-lightbox-caption');
    const close = lightbox.querySelector<HTMLButtonElement>('.frost-image-lightbox-close');

    gallery.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const link = target.closest('a[data-frost-gallery-image]');
      if (!(link instanceof HTMLAnchorElement) || !image || !caption) return;

      event.preventDefault();
      image.src = link.href;
      image.alt = link.dataset.frostGalleryCaption ?? '';
      caption.textContent = link.dataset.frostGalleryCaption ?? '';
      lightbox.showModal();
    });

    close?.addEventListener('click', () => lightbox.close());
    lightbox.addEventListener('click', (event) => {
      if (event.target === lightbox) lightbox.close();
    });
  }
</script>
