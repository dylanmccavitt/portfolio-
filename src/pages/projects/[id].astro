---
import Frost from '@/layouts/Frost.astro';
import { publicProjectStaticPaths } from '@/lib/public-project-route-resolver';
import { loadPublicProjectDetailBySlug, loadPublicProjectDetails } from '@/lib/public-projects';
import { projectMeta } from '@/lib/seo';

export async function getStaticPaths() {
  const { projects } = await loadPublicProjectDetails();
  return publicProjectStaticPaths(projects);
}

const slug = Astro.params.id ?? '';
const { project } = await loadPublicProjectDetailBySlug(slug);
if (!project) return new Response(null, { status: 404, statusText: 'Not Found' });

const p = project;
const meta = projectMeta(p);
---

<Frost title={meta.title} meta={meta}>
  <main class="frost frost-doc" id="main">
    <header class="frost-doc-head">
      <a href="/">Dylan McCavitt</a>
      <nav aria-label="Primary">
        <a href="/#about">About</a>
        <a href="/#work">Work</a>
        <a href="/#journey">Journey</a>
        <a href="/#contact">Contact</a>
      </nav>
    </header>

    <div class="frost-doc-title">
      <h1>{p.title}</h1>
      <p class="frost-kicker">{p.area} · {p.status[1]} · {p.year}</p>
      <p style="max-width:640px; margin:14px 0 0; font-size:15px; line-height:1.6;">{p.line}</p>
    </div>

    <section class="frost-doc-section" aria-labelledby="project-shipped">
      <h2 id="project-shipped">What shipped</h2>
      {p.about.slice(0, 1).map((paragraph) => (
        <p style="max-width:640px; margin:0; font-size:14px; line-height:1.65; color:var(--frost-muted);">{paragraph}</p>
      ))}
    </section>

    <section class="frost-doc-section" aria-labelledby="project-evidence">
      <h2 id="project-evidence">Evidence</h2>
      <div class="frost-doc-facts">
        {p.metrics.slice(0, 3).map((metric) => <span>{metric.value} — {metric.label}</span>)}
      </div>
    </section>

    {(p.about.length > 1 || p.notes.length > 0) && (
      <section class="frost-doc-section" aria-labelledby="project-more">
        <h2 id="project-more">More detail</h2>
        {p.about.slice(1).map((paragraph) => (
          <p style="max-width:640px; margin:0 0 12px; font-size:14px; line-height:1.65; color:var(--frost-muted);">{paragraph}</p>
        ))}
        {p.notes.length > 0 && (
          <ul style="max-width:640px; margin:0; padding-left:18px; font-size:13.5px; line-height:1.7; color:var(--frost-muted);">
            {p.notes.map((note) => <li>{note}</li>)}
          </ul>
        )}
      </section>
    )}

    <nav class="frost-doc-actions" aria-label="Project actions">
      {p.links.map((link, index) => (
        <a class:list={[{ 'is-fill': index === 0 }]} href={link.href} target="_blank" rel="noopener">{link.label}</a>
      ))}
      <a class="is-quiet" href="/#work">← All work</a>
    </nav>
  </main>
</Frost>
