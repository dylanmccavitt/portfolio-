---
import Frost from '@/layouts/Frost.astro';
import { publicProjectStaticPaths } from '@/lib/public-project-route-resolver';
import { loadPublicProjectDetailBySlug, loadPublicProjectDetails } from '@/lib/public-projects';
import { projectMeta } from '@/lib/seo';

export async function getStaticPaths() {
  const { projects } = await loadPublicProjectDetails();
  return publicProjectStaticPaths(projects);
}

const slug = Astro.params.id ?? '';
const { project } = await loadPublicProjectDetailBySlug(slug);
if (!project) return new Response(null, { status: 404, statusText: 'Not Found' });

const p = project;
const meta = projectMeta(p);
const imageShots = p.shots.filter((shot) => shot.kind === 'image');

// Catalog convention (#350): `about` is exactly [problem, approach, outcome].
// Rows published before that convention may carry fewer paragraphs — fail
// soft to a single About section rather than mislabeling prose.
const hasStory = p.about.length >= 3;
const story = hasStory
  ? [
      ['Problem', p.about[0]],
      ['Approach', p.about[1]],
      ['Outcome', p.about[2]],
    ]
  : [];
---

<Frost title={meta.title} meta={meta}>
  <main class="frost frost-doc look-paper" id="main">
    <header class="frost-doc-head">
      <a href="/">Dylan McCavitt</a>
      <nav aria-label="Primary">
        <a href="/#about">About</a>
        <a href="/#work">Work</a>
        <a href="/#journey">Journey</a>
        <a href="/#contact">Contact</a>
      </nav>
    </header>

    <div class="frost-flow-in">
      <div class="frost-doc-title look-title">
        <p class="frost-kicker">{p.area} · {p.status[1]} · {p.year}</p>
        <h1>{p.title}</h1>
        <p class="look-title-line">{p.line}</p>
      </div>
    </div>

    {hasStory ? (
      story.map(([heading, paragraph]) => (
        <div class="frost-flow-in">
          <section class="look-block" aria-labelledby={`project-${heading.toLowerCase()}`}>
            <h2 id={`project-${heading.toLowerCase()}`}>{heading}</h2>
            <p class="look-copy">{paragraph}</p>
          </section>
        </div>
      ))
    ) : (
      <div class="frost-flow-in">
        <section class="look-block" aria-labelledby="project-about">
          <h2 id="project-about">About</h2>
          {p.about.map((paragraph) => <p class="look-copy" style="margin-bottom:12px;">{paragraph}</p>)}
        </section>
      </div>
    )}

    {p.stack.length > 0 && (
      <div class="frost-flow-in">
        <section class="look-block" aria-labelledby="project-stack">
          <h2 id="project-stack">Stack</h2>
          <div class="frost-doc-facts">
            {p.stack.map((entry) => <span>{entry.label}: {entry.value}</span>)}
          </div>
        </section>
      </div>
    )}

    <div class="frost-flow-in">
      <section class="look-block" aria-labelledby="project-metrics">
        <h2 id="project-metrics">Metrics</h2>
        <div class="look-paper-pane">
          <div class="frost-doc-facts">
            {p.metrics.map((metric) => <span>{metric.value} — {metric.label}</span>)}
          </div>
        </div>
      </section>
    </div>

    {imageShots.length > 0 && (
      <div class="frost-flow-in">
        <section class="look-block" aria-labelledby="project-screens">
          <h2 id="project-screens">Screens</h2>
          <div class="frost-gallery">
            {imageShots.map((shot) => (
              <figure>
                <img src={shot.src} alt={shot.caption} loading="lazy" />
                <figcaption>{shot.caption}</figcaption>
              </figure>
            ))}
          </div>
        </section>
      </div>
    )}

    <nav class="frost-doc-actions" aria-label="Project actions">
      {p.links.map((link, index) => (
        <a class:list={[{ 'is-fill': index === 0 }]} href={link.href} target="_blank" rel="noopener">{link.label}</a>
      ))}
      <a class="is-quiet" href="/#work">← All work</a>
    </nav>
  </main>

  <script>
    const blocks = document.querySelectorAll('.frost-flow-in');
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12 },
      );
      blocks.forEach((block) => io.observe(block));
    } else {
      blocks.forEach((block) => block.classList.add('is-in'));
    }
  </script>
</Frost>
