---
import Frost from '@/layouts/Frost.astro';
import DmDock from '@/components/frost/DmDock.jsx';
import ProjectBody from '@/components/frost/ProjectBody.astro';
import { PROFILE } from '@/components/frost/frost-data.js';
import { resolveDmEndpoint } from '@/components/frost/dm-client.js';
import { buildDmPageManifest } from '@/lib/dm/page-manifest';
import { publicProjectStaticPaths } from '@/lib/public-project-route-resolver';
import { loadPublicProjectDetailBySlug, loadPublicProjectDetails } from '@/lib/public-projects';
import { projectMeta } from '@/lib/seo';

export async function getStaticPaths() {
  const { projects } = await loadPublicProjectDetails();
  return publicProjectStaticPaths(projects);
}

const slug = Astro.params.id ?? '';
const { project } = await loadPublicProjectDetailBySlug(slug);
if (!project) return new Response(null, { status: 404, statusText: 'Not Found' });

const p = project;
const meta = projectMeta(p);

const dmEndpoint = resolveDmEndpoint(import.meta.env.PUBLIC_DM_ENDPOINT);
const dmManifest = dmEndpoint ? await buildDmPageManifest() : null;
const dmProjects = dmEndpoint
  ? (await loadPublicProjectDetails()).projects.map((entry) => ({
      id: entry.id,
      slug: entry.slug,
      href: entry.href,
      title: entry.title,
    }))
  : [];
---

<Frost title={meta.title} meta={meta}>
  <main class="frost frost-doc frost-doc--explore" id="main">
    <header class="frost-doc-head frost-doc-head--explore">
      <a class="frost-sr-only" href="/">{PROFILE.name}: home</a>
      <p class="frost-site-here">
        <a class="frost-site-here-label" href="/#work">Work</a>
      </p>
      <nav aria-label="Primary" class="frost-sr-only">
        <a href="/#about">About</a>
        <a href="/#work">Work</a>
        <a href="/#journey">Journey</a>
        <a href="/#contact">Contact</a>
      </nav>
      <div class="frost-site-actions">
        {dmEndpoint ? (
          <DmDock
            client:only="react"
            endpoint={dmEndpoint}
            manifest={dmManifest}
            projects={dmProjects}
          />
        ) : (
          <a class="frost-dm-button" href={`mailto:${PROFILE.email}`}>Ask DM</a>
        )}
      </div>
    </header>

    <ProjectBody project={p} />
  </main>
</Frost>
