---
import Frost from '@/layouts/Frost.astro';
import FrostSite from '@/components/frost/FrostSite.jsx';
import { WORK_ORDER } from '@/components/frost/frost-data.js';
import { TIMELINE_HUE, ditherOrbSvg, hueForArea } from '@/lib/dither';
import { buildDmPageManifest } from '@/lib/dm/page-manifest';
import { publicJourneyRows } from '@/lib/journey';
import { loadPublicProjectDetails } from '@/lib/public-projects';
import { libraryMeta, personJsonLd } from '@/lib/seo';

const meta = {
  ...libraryMeta(
    'Dylan McCavitt',
    'Software engineer in New York City building practical product, backend, and AI tools.',
  ),
  jsonLd: personJsonLd(),
};

// Build-time read of the published detail models (published-DB on deploy,
// catalog offline). WORK_ORDER pins the display order; anything the order
// list doesn't know lands at the end in source order.
const { projects } = await loadPublicProjectDetails();
const rank = (id: string) => {
  const index = WORK_ORDER.indexOf(id);
  return index === -1 ? WORK_ORDER.length : index;
};
// "Shipped & client work · Shipped" says it once: the status is dropped
// when the area label already contains that word.
const cardEyebrow = (area: string, status: string) =>
  area.toLowerCase().includes(status.toLowerCase()) ? area : `${area} · ${status}`;

const workProjects = [...projects]
  .sort((a, b) => rank(a.id) - rank(b.id))
  .map((project) => ({
    id: project.id,
    slug: project.slug,
    href: project.href,
    title: project.title,
    eyebrow: cardEyebrow(project.area, project.status[1]),
    // The card's dither accent tint. Same hue the project's own page uses,
    // so the Work grid colour-codes by area and each card agrees with the
    // page it opens.
    hue: hueForArea(project.area),
    line: project.line,
  }));

// The Journey rows, read through the resume's public-track allowlist rather
// than from a second hardcoded list. See `src/lib/journey.ts`.
const journey = publicJourneyRows();

// The Journey row marker, rasterised here at build time rather than drawn on
// a canvas in the island: every row shows the same orb, so it is one string
// computed once and handed to the component to stamp per row.
const journeyOrb = ditherOrbSvg({ color: TIMELINE_HUE, size: 11 });

// The DM corner card's page-action allowlist. Anchors and project ids only —
// both already in this page's HTML — passed as a build-time prop so no corpus
// document is published and the browser fetches nothing.
const dmManifest = await buildDmPageManifest();
---

<Frost title="Dylan McCavitt · Software engineer" meta={meta}>
  <FrostSite
    client:load
    projects={workProjects}
    journey={journey}
    journeyOrb={journeyOrb}
    dmManifest={dmManifest}
    initialEffects={false}
  />
</Frost>
