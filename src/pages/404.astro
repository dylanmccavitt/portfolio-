---
import Frost from '@/layouts/Frost.astro';
import { PROFILE } from '@/components/frost/frost-data.js';
import { libraryMeta } from '@/lib/seo';

const meta = libraryMeta(
  'Page not found',
  'That portfolio URL is no longer active. Browse the work or contact Dylan directly.',
);
---

<Frost title="Page not found · Dylan McCavitt" meta={meta}>
  <main class="frost frost-doc frost-doc--explore" id="main">
    <header class="frost-doc-head frost-doc-head--explore">
      <a class="frost-sr-only" href="/">{PROFILE.name}: home</a>
      <p class="frost-site-here">
        <span class="frost-site-here-label">404</span>
      </p>
      <nav aria-label="Primary" class="frost-sr-only">
        <a href="/#about">About</a>
        <a href="/#work">Work</a>
        <a href="/#journey">Journey</a>
        <a href="/#contact">Contact</a>
      </nav>
      <div class="frost-site-actions">
        <a class="frost-dm-button" href={`mailto:${PROFILE.email}`}>Ask DM</a>
      </div>
    </header>

    <div class="frost-doc-title">
      <p class="frost-kicker">404</p>
      <h1>This page cracked off entirely.</h1>
      <p style="max-width:560px; margin:14px 0 0; font-size:15px; line-height:1.6; color:var(--frost-muted);">
        That URL is no longer active. The work, journey, and contact details all
        live on the homepage now.
      </p>
    </div>

    <nav class="frost-doc-actions" aria-label="Recovery">
      <a class="is-fill" href="/">Back to the site</a>
      <a href="mailto:dylanmccavitt@outlook.com">Email Dylan</a>
    </nav>
  </main>
</Frost>
