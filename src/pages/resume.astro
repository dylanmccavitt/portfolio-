---
import Frost from '@/layouts/Frost.astro';
import { PROFILE } from '@/components/frost/frost-data.js';
import { publicResumeEducationTracks, publicResumeExperienceTracks } from '@/data/resume';
import { journeyMeta } from '@/lib/seo';

// The sections come from the public track allowlist in `src/data/resume.ts`,
// which the DM corpus reads too — this page keeps no list of its own.
const meta = journeyMeta();
const experience = publicResumeExperienceTracks();
const education = publicResumeEducationTracks();
---

<Frost title="Resume · Dylan McCavitt" meta={meta}>
  <main class="frost frost-doc frost-doc--explore" id="main">
    <header class="frost-doc-head frost-doc-head--explore">
      <a class="frost-sr-only" href="/">{PROFILE.name} — home</a>
      <p class="frost-site-here">
        <a class="frost-site-here-label" href="/#journey">Journey</a>
      </p>
      <nav aria-label="Primary" class="frost-sr-only">
        <a href="/#about">About</a>
        <a href="/#work">Work</a>
        <a href="/#journey">Journey</a>
        <a href="/#contact">Contact</a>
      </nav>
      <div class="frost-site-actions">
        <a class="frost-dm-button" href={`mailto:${PROFILE.email}`}>Ask DM</a>
      </div>
    </header>

    <div class="frost-doc-title">
      <h1>Resume</h1>
      <p class="frost-kicker">Software engineer · NYC/NJ area · focusing on agentic tooling · US citizen, no sponsorship needed</p>
    </div>

    <section class="frost-doc-section" aria-labelledby="resume-experience">
      <h2 id="resume-experience">Experience</h2>
      {experience.map((entry) => (
        <article class="frost-doc-row">
          <h3>{entry.title} <span>· {entry.role} · {entry.when}</span></h3>
          <p>{entry.about[0]}</p>
        </article>
      ))}
    </section>

    <section class="frost-doc-section" aria-labelledby="resume-education">
      <h2 id="resume-education">Education</h2>
      {education.map((entry) => (
        <article class="frost-doc-row">
          <h3>{entry.role} <span>· {entry.title} · {entry.when}</span></h3>
        </article>
      ))}
    </section>

    <section class="frost-doc-section" aria-labelledby="resume-focus">
      <h2 id="resume-focus">Focus</h2>
      <div class="frost-doc-facts">
        <span>Backend systems</span>
        <span>Product engineering</span>
        <span>Practical AI tools</span>
      </div>
    </section>

    <nav class="frost-doc-actions" aria-label="Resume actions">
      <a class="is-fill" href="https://dylanmccavitt.xyz/resume.pdf">Download PDF</a>
      <a href="mailto:dylanmccavitt@outlook.com">Email Dylan</a>
      <a class="is-quiet" href="/#journey">View journey →</a>
    </nav>
  </main>
</Frost>
