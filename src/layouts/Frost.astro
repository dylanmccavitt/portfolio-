---
import { OG_FALLBACK, serializeJsonLd, type PageMeta } from '@/lib/seo';

export interface Props {
  title: string;
  description?: string;
  meta?: PageMeta;
}

const { title, description = 'Dylan McCavitt · Portfolio', meta } = Astro.props;

const path = Astro.url.pathname.length > 1 ? Astro.url.pathname.replace(/\/$/, '') : '/';
const canonical = new URL(path, Astro.site).href;
const metaDescription = meta?.description ?? description;
const ogImage = new URL(meta?.ogImage ?? OG_FALLBACK, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={metaDescription} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content={meta?.ogType ?? 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Dylan McCavitt" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    {meta?.jsonLd && <script is:inline type="application/ld+json" set:html={serializeJsonLd(meta.jsonLd)} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <style>
      /* Frost palette inlined: the --frost-* tokens are scoped to .frost, and this link sits outside it. */
      .skip-link {
        position: absolute;
        top: 8px;
        left: 8px;
        z-index: 100;
        transform: translateY(-150%);
        transition: transform 0.15s ease;
        background: #eef2f4;
        color: #26343d;
        border: 1.5px solid #26343d;
        border-radius: 7px;
        padding: 8px 14px;
        font-family: "Geist Variable", "Helvetica Neue", Arial, sans-serif;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
      }
      .skip-link:focus-visible {
        transform: translateY(0);
        outline: 2px solid #26343d;
        outline-offset: 2px;
      }
    </style>
  </head>
  <body style="margin:0">
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
