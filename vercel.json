{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://dm-agent-service-psi.vercel.app; manifest-src 'self'; upgrade-insecure-requests"
        }
      ]
    }
  ],
  "redirects": [
    { "source": "/projects/epl-ml-model", "destination": "/projects/epl-ml", "permanent": true },
    { "source": "/library/trading-systems", "destination": "/#work", "permanent": true },
    { "source": "/library/agents-mcp", "destination": "/#work", "permanent": true },
    { "source": "/library/ios", "destination": "/#work", "permanent": true },
    { "source": "/library/shipped", "destination": "/#work", "permanent": true },
    { "source": "/library/school", "destination": "/#work", "permanent": true },
    { "source": "/library/infrastructure", "destination": "/#work", "permanent": true },
    { "source": "/library/research", "destination": "/#work", "permanent": true },
    { "source": "/experience", "destination": "/journey", "permanent": true },
    { "source": "/about", "destination": "/#about", "permanent": true },
    { "source": "/journey/:slug", "destination": "/#journey", "permanent": true },
    { "source": "/log", "destination": "/library", "permanent": true },
    { "source": "/log/:slug", "destination": "/library", "permanent": true },
    { "source": "/homelab/topology", "destination": "/#work", "permanent": true },
    { "source": "/player", "destination": "/", "permanent": true },
    { "source": "/projects", "destination": "/library", "permanent": true }
  ]
}
