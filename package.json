{
  "name": "dylan-portfolio",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "test": "npm run test:release && npm run test:routes && npm run test:quality",
    "test:release": "node --import tsx --test tests/release-gates.test.ts",
    "test:routes": "node --import tsx --test tests/route-coverage.test.ts",
    "test:quality": "node --import tsx --test tests/replacement-quality-proof.test.ts",
    "proof:quality": "tsx scripts/replacement-quality-proof.ts",
    "package:quality": "tsx scripts/build-replacement-quality-artifact.ts",
    "typecheck": "astro check",
    "verify": "npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/react": "^6.0.1",
    "@astrojs/vercel": "^11.0.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.2.8",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.0.3",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "satori": "^0.26.0",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "eslint": "^10.1.0",
    "eslint-plugin-astro": "^1.6.0",
    "sharp": "^0.34.5",
    "tsx": "^4.22.4",
    "typescript-eslint": "^8.58.0"
  },
  "overrides": {
    "path-to-regexp": "6.3.0",
    "yaml": "^2.8.3"
  }
}
